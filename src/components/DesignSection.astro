---
const hv = "'Helvetica Neue', Helvetica, Arial, sans-serif";
---

<section class="max-w-[1280px] mx-auto px-6 lg:px-20 py-20">

  <!-- Section header (same style as Art) -->
  <div class="mb-4">
    <h2 style={`font-size: 64px; font-weight: 700; line-height: 1; margin: 0; font-family: ${hv}; letter-spacing: -0.02em;`}>Design</h2>
  </div>
  <hr class="section-divider mb-10" />

  <!-- Grid -->
  <div class="flex flex-col gap-5">

    <!-- ROW 1: Bioderma (~55%) | Social Assets (~45%) -->
    <div class="flex flex-col md:flex-row gap-5 md:h-[400px]">
      <div class="w-full aspect-[4/3] md:aspect-auto md:min-w-0" style="flex: 55;">
        <a href="/projects/bioderma" class="design-card design-card--link h-full">
          <img src="https://res.cloudinary.com/dvfhegxgx/image/upload/v1773211466/bioderma_xhraqj.jpg" alt="Bioderma" loading="lazy" />
          <div class="overlay">
            <h3 class="card-title">Bioderma</h3>
          </div>
        </a>
      </div>
      <div class="w-full aspect-[4/3] md:aspect-auto md:min-w-0" style="flex: 45;">
        <a href="/projects/social-assets" class="design-card design-card--link h-full">
          <img src="https://res.cloudinary.com/dvfhegxgx/image/upload/v1773211507/social-assets_yvb3pl.jpg" alt="Social Assets" loading="lazy" />
          <div class="overlay">
            <h3 class="card-title">Social Assets</h3>
          </div>
        </a>
      </div>
    </div>

    <!-- ROW 2: Branding 888 (~33%) | Credicorp (~66%) -->
    <div class="flex flex-col md:flex-row gap-5 md:h-[400px]">
      <div class="w-full aspect-[4/3] md:aspect-auto md:min-w-0" style="flex: 33;">
        <a href="/projects/branding-888" class="design-card design-card--link h-full">
          <img src="https://res.cloudinary.com/dvfhegxgx/image/upload/v1773211469/branding-888_gdbqmn.jpg" alt="Branding 888" loading="lazy" />
          <div class="overlay">
            <h3 class="card-title">Branding</h3>
          </div>
        </a>
      </div>
      <div class="w-full aspect-[4/3] md:aspect-auto md:min-w-0" style="flex: 66;">
        <a href="/projects/credicorp" class="design-card design-card--link h-full">
          <img src="https://res.cloudinary.com/dvfhegxgx/image/upload/v1773211471/credicorp_trcjyp.jpg" alt="Credicorp" loading="lazy" />
          <div class="overlay">
            <h3 class="card-title">Credicorp</h3>
          </div>
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  .design-card {
    position: relative;
    display: block;
    border-radius: 30px;
    overflow: hidden;
    background: #f3f4f6;
    box-shadow: 0 2px 8px 0 rgba(0, 0, 0, 0.06);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: default;
  }

  .design-card--link {
    cursor: pointer;
  }

  .design-card:hover {
    transform: scale(1.03) translateY(-4px);
    box-shadow: 0 8px 24px 0 rgba(0, 0, 0, 0.12);
  }

  .design-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .design-card:hover img {
    transform: scale(1.05);
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 16px;
    gap: 2px;
    transition: background 0.3s ease;
  }

  .design-card:hover .overlay {
    background: rgba(0, 0, 0, 0.3);
  }

  .overlay > * {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .design-card:hover .overlay > * {
    opacity: 1;
    transform: translateY(0);
  }

  .subtitle {
    color: #fff;
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  .card-title {
    color: #fff;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.2;
    margin: 0;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }
</style>
