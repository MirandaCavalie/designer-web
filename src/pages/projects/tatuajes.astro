---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';

const year = new Date().getFullYear();
const hv = "'Helvetica Neue', Helvetica, Arial, sans-serif";

const bodyText = `I tattoo only my own designs, created within the emotional and symbolic world of Punto y Raya.
Each piece begins as a personal drawing and becomes something permanent when translated to skin.
Clients can choose from existing flash designs or request a custom piece created in my style.`;
---

<Layout
  title="Tatuajes — Fernanda Jara Meza"
  description="Custom tattoo designs created within the emotional and symbolic world of Punto y Raya."
>
  <Navbar />

  <main style="background: #EFEFEF;">

    <div style="padding-top: 170px;"></div>

    <!-- ─────────────────────────────────────────── -->
    <!-- SECTION 1 · TATTOO PHOTO GRID              -->
    <!-- ─────────────────────────────────────────── -->
    <div style="font-size: 0; line-height: 0;">
      <img
        src="https://res.cloudinary.com/dvfhegxgx/image/upload/v1773211308/tatus_01_ye19sp.png"
        alt="Tattoo photo grid — flash designs and skin work"
        class="bleed"
      />
    </div>

    <!-- ─────────────────────────────────────────── -->
    <!-- SECTION 2 · PARAGRAPH                      -->
    <!-- ─────────────────────────────────────────── -->
    <section style="padding-top: 60px; padding-bottom: 60px;">
      <div class="reveal" style={`max-width: 900px; margin: 0 auto; padding: 0 24px; text-align: center; font-family: ${hv}; font-size: 20px; line-height: 1.25; letter-spacing: -0.02em; color: #000000; font-weight: 400;`}>
        <p style="margin: 0;">{bodyText}</p>
      </div>
    </section>

    <!-- ─────────────────────────────────────────── -->
    <!-- SECTION 3 · INSTAGRAM STORIES MOCKUPS      -->
    <!-- ─────────────────────────────────────────── -->
    <div style="font-size: 0; line-height: 0;">
      <video autoplay loop muted playsinline class="bleed">
        <source src="https://res.cloudinary.com/dvfhegxgx/video/upload/v1773213182/tatus_02_o2r8sz.mp4" type="video/mp4" />
      </video>
    </div>

    <!-- ─────────────────────────────────────────── -->
    <!-- SECTION 4 · BEACH / COLLAGE                -->
    <!-- ─────────────────────────────────────────── -->
    <div style="font-size: 0; line-height: 0;">
      <img
        src="https://res.cloudinary.com/dvfhegxgx/image/upload/v1773211311/tatus_04_odxkum.png"
        alt="Collage — beach photo, drawing of person with dog, tattoo close-ups"
        class="bleed"
      />
    </div>

    <!-- ─────────────────────────────────────────── -->
    <!-- SECTION 5 · PARAGRAPH (repeat)             -->
    <!-- ─────────────────────────────────────────── -->
    <section style="padding-top: 60px; padding-bottom: 60px;">
      <div class="reveal" style={`max-width: 900px; margin: 0 auto; padding: 0 24px; text-align: center; font-family: ${hv}; font-size: 20px; line-height: 1.25; letter-spacing: -0.02em; color: #000000; font-weight: 400;`}>
        <p style="margin: 0;">{bodyText}</p>
      </div>
    </section>

    <!-- ─────────────────────────────────────────── -->
    <!-- SECTION 6 · FLASH SHEETS 2×2 GRID          -->
    <!-- ─────────────────────────────────────────── -->
    <div style="font-size: 0; line-height: 0;">
      <img
        src="https://res.cloudinary.com/dvfhegxgx/image/upload/v1773211313/tatus_05_cjskzt.png"
        alt="Flash sheets with landscape backgrounds — 2×2 grid"
        class="bleed"
      />
    </div>

    <!-- FOOTER -->
    <footer class="max-w-[1280px] mx-auto px-6 lg:px-20 py-10 border-t border-[#E0E0E0]">
      <div
        class="flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-gray-400"
        style={`font-family: ${hv};`}
      >
        <span>© {year} Fernanda Jara Meza</span>
      </div>
    </footer>

  </main>
</Layout>

<style>
  .bleed {
    display: block;
    width: 100vw;
    max-width: none;
    margin-left: calc(-50vw + 50%);
    height: auto;
  }

  .reveal {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity 0.65s ease, transform 0.65s ease;
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  :global(body) {
    overflow-x: hidden;
  }
</style>

<script>
  const els = document.querySelectorAll<HTMLElement>('.reveal');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.08 }
  );
  els.forEach((el) => observer.observe(el));
</script>
